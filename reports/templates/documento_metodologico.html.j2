    <tr><td>EPH, microdatos de hogares e individuos <a href="#r1">[R1]</a></td><td>INDEC</td><td>Ingreso de los hogares, tenencia de la vivienda, trabajo, aportes, composición del hogar</td><td>2T-2025 a 1T-2026</td></tr>
